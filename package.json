{
  "name": "@local/dsh-settings-sidebar",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Show or hide sidebar panel entries and add shortcuts to Settings sections in DeepSeek Harness.",
  "license": "MIT",
  "author": "zyileven",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyileven/dsh-settings-sidebar.git"
  },
  "homepage": "https://github.com/zyileven/dsh-settings-sidebar#readme",
  "bugs": { "url": "https://github.com/zyileven/dsh-settings-sidebar/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "sidebar", "settings"],
  "scripts": {
    "test": "node --check client.js && node --check index.js && node --test client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "assets/icon-256.png", "README.md", "README.zh-CN.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-general", "@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
